<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="HudRoot" style="position: absolute; left: 16px; top: 16px; padding: 12px; background-color: rgba(20, 20, 28, 0.85); border-radius: 8px; border-width: 1px; border-color: rgba(255, 255, 255, 0.2);">
        <ui:Label name="StateLabel" text="State: DecideState | Active: Player" style="color: rgb(240, 240, 245); font-size: 14px; margin-bottom: 4px;" />
        <ui:Label name="InfoLabel" text="Target: Red | Player: 4 | AI: 4" style="color: rgb(200, 200, 215); font-size: 13px; margin-bottom: 6px;" />
        <ui:Label name="ControlsLabel" text="LMB: Play / Pass | RMB: Deselect / Challenge" style="color: rgb(255, 215, 100); font-size: 13px;" />
    </ui:VisualElement>
</ui:UXML>
