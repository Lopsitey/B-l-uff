MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 862599296}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 68545fc5c18295d4195a5b003d50cbd9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Bluff.Managers.CardRoundManager
  m_DialogueManager: {fileID: 167032116}
  m_PlayerArmManager: {fileID: 1185445239}
  m_OpponentArmManager: {fileID: 1090152040}
  m_AIProfile: {fileID: 11400000, guid: c6c9f0345511c4044b305bd2cc83fa6d, type: 2}
  m_IntroDialogue:
  - character: {fileID: 11400000, guid: c2110277ebf30364db303556a4229460, type: 2}
    text: Welcome to purgatory.
    autoplayDelay: 0
  - character: {fileID: 11400000, guid: 872fa4e2181e96c438232e8ea095fc69, type: 2}
    text: What am I doing here?
    autoplayDelay: 2
  m_PlayerAddedItemDialogue:
  - character: {fileID: 11400000, guid: 872fa4e2181e96c438232e8ea095fc69, type: 2}
    text: Eat this!
    autoplayDelay: 0
  m_AIAddedItemDialogue:
  - character: {fileID: 11400000, guid: 916d8ef55cedd704288bd958ba5ac51c, type: 2}
    text: Feel my wrath!
    autoplayDelay: 0
  m_CallOutWrongDialogue:
  - character: {fileID: 11400000, guid: 916d8ef55cedd704288bd958ba5ac51c, type: 2}
    text: Haha, you fool!
    autoplayDelay: 0
  - character: {fileID: 11400000, guid: 872fa4e2181e96c438232e8ea095fc69, type: 2}
    text: Just you wait!
    autoplayDelay: 2
  m_CallOutCorrectDialogue:
  - character: {fileID: 11400000, guid: 872fa4e2181e96c438232e8ea095fc69, type: 2}
    text: Who's laughing now?
    autoplayDelay: 0
  - character: {fileID: 11400000, guid: 916d8ef55cedd704288bd958ba5ac51c, type: 2}
    text: NOOO!
    autoplayDelay: 2
  m_GetCalledOutWrongDialogue:
  - character: {fileID: 11400000, guid: 916d8ef55cedd704288bd958ba5ac51c, type: 2}
    text: Clever mortal!
    autoplayDelay: 0
  - character: {fileID: 11400000, guid: 872fa4e2181e96c438232e8ea095fc69, type: 2}
    text: I thought you were a meant to be god.
    autoplayDelay: 2
  m_GetCalledOutCorrectDialogue:
  - character: {fileID: 11400000, guid: 916d8ef55cedd704288bd958ba5ac51c, type: 2}
    text: You can't decieve a god!
    autoplayDelay: 0
  - character: {fileID: 11400000, guid: 872fa4e2181e96c438232e8ea095fc69, type: 2}
    text: We'll see about that...
    autoplayDelay: 2
  m_WinDialogue:
  - character: {fileID: 11400000, guid: 916d8ef55cedd704288bd958ba5ac51c, type: 2}
    text: "Well done puny human.\t"
    autoplayDelay: 0
  - character: {fileID: 11400000, guid: 872fa4e2181e96c438232e8ea095fc69, type: 2}
    text: My daughter is saved!
    autoplayDelay: 2
  m_LoseDialogue:
  - character: {fileID: 11400000, guid: 916d8ef55cedd704288bd958ba5ac51c, type: 2}
    text: Another soul for the damned.
    autoplayDelay: 0
  - character: {fileID: 11400000, guid: 872fa4e2181e96c438232e8ea095fc69, type: 2}
    text: I don't deserve this!
    autoplayDelay: 2
  m_WinLossText: {fileID: 1901630484}
  m_ItemPrefab: {fileID: 8809188124523310579, guid: 81d513c505cd4b94eb755794956cb2de, type: 3}
  m_HandContainer: {fileID: 1570563433}
  m_HeldItemContainer: {fileID: 8339669}
  m_ItemSpacing: 3
  m_CardsPerRow: 6
  m_RowYOffset: 8
