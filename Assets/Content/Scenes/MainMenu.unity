--- !u!114 &1402363196
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1402363195}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6ba80f5755e2a524293142ccf7b050e7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueLines:
  - character: {fileID: 11400000, guid: 872fa4e2181e96c438232e8ea095fc69, type: 2}
    text: You were prised from my arms too soon my darling daughter.
    autoplayDelay: 2
  - character: {fileID: 11400000, guid: 872fa4e2181e96c438232e8ea095fc69, type: 2}
    text: 'I can''t stand for us to be apart. '
    autoplayDelay: 2
  - character: {fileID: 11400000, guid: 872fa4e2181e96c438232e8ea095fc69, type: 2}
    text: O' Lord above. I hear your thunder...
    autoplayDelay: 2
  - character: {fileID: 11400000, guid: 872fa4e2181e96c438232e8ea095fc69, type: 2}
    text: But do you hear ME?
    autoplayDelay: 2
  - character: {fileID: 11400000, guid: 872fa4e2181e96c438232e8ea095fc69, type: 2}
    text: ...
    autoplayDelay: 4
  - character: {fileID: 11400000, guid: 872fa4e2181e96c438232e8ea095fc69, type: 2}
    text: I see your GREED.
    autoplayDelay: 2
  - character: {fileID: 11400000, guid: 872fa4e2181e96c438232e8ea095fc69, type: 2}
    text: Two kingdoms of heaven and earth both brimming with adoration for YOU.
    autoplayDelay: 2
  - character: {fileID: 11400000, guid: 872fa4e2181e96c438232e8ea095fc69, type: 2}
    text: 'and yet... I ask to share it with one of your angels for a little longer. '
    autoplayDelay: 1
  - character: {fileID: 11400000, guid: 872fa4e2181e96c438232e8ea095fc69, type: 2}
    text: And this...                                      You refuse to do.
    autoplayDelay: 3
  - character: {fileID: 11400000, guid: c2110277ebf30364db303556a4229460, type: 2}
    text: 'Psst. Over here you fool, by the Church. Take shelter from the blasted
      rain. '
    autoplayDelay: 2
  - character: {fileID: 11400000, guid: c2110277ebf30364db303556a4229460, type: 2}
    text: Many a lost soul, filled with anger, venture here looking for answers.
    autoplayDelay: 2
  - character: {fileID: 11400000, guid: c2110277ebf30364db303556a4229460, type: 2}
    text: The lord you speak of has abandoned us all.
    autoplayDelay: 1
  - character: {fileID: 11400000, guid: c2110277ebf30364db303556a4229460, type: 2}
    text: He abandoned Master too.
    autoplayDelay: 1
  - character: {fileID: 11400000, guid: c2110277ebf30364db303556a4229460, type: 2}
    text: But Master will help you.
    autoplayDelay: 2
  - character: {fileID: 11400000, guid: c2110277ebf30364db303556a4229460, type: 2}
    text: Come inside...
    autoplayDelay: 3
  charactersPerSecond: 20
  playerPanel: {fileID: 1203479420}
  enemyPanel: {fileID: 2006586388}
  DialogueBox: {fileID: 748670422}
  Portrait: {fileID: 16951153}
  DialogueText: {fileID: 890282021}
